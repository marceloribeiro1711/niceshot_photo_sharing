{
  "keep_vars": true,
  // O "name" precisa ser igual ao nome do Worker no painel da Cloudflare.
  "name": "niceshot-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  // Armazenamento dos eventos e do PIN (o mesmo KV que você já criou).
  "kv_namespaces": [
    { "binding": "EVENTS", "id": "41f1e1266ff34f1cbe75920aad323df1" }
  ],

  // Correio da busca por selfie (criado sozinho no deploy; nada a fazer no painel).
  "durable_objects": { "bindings": [{ "name": "FILA", "class_name": "Fila" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fila"] }],

  // Endereço do app (GitHub Pages). Vários endereços: separe por vírgula.
  "vars": { "ALLOWED_ORIGIN": "https://marceloribeiro1711.github.io" }

  // As chaves GOOGLE_API_KEY, ADMIN_KEY, TOKEN_SECRET e MAC_KEY ficam só no painel
  // (Settings > Variables and Secrets). Nunca coloque chaves neste arquivo.
}
